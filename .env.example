# Environment configuration reference
#
# gateway/config.py reads every one of these at process start, falling
# back to the default shown here (which reproduces the app's original
# hardcoded behavior) when a variable isn't set. There is no .env
# autoloader in this project (no python-dotenv) — copying this to `.env`
# alone has no effect. Export these into the actual process environment,
# or use `docker compose --env-file .env` / a compose `environment:`
# block.
#
#   cp .env.example .env   # then export its contents, e.g.:
#   set -a && source .env && set +a

# --- Auth (gateway/main.py, gateway/middleware/auth.py) ---
SECRET_KEY=mysecretkey
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# --- Demo credential store (gateway/auth_store.py) ---
# Seeded in-memory for local dev only; not a real user base, no database.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=ChangeMe123!

# --- Redis (gateway/utils/redis_client.py) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Response cache (gateway/middleware/cache.py) ---
CACHE_TTL_SECONDS=10

# --- Rate limiting (gateway/middleware/rate_limit.py) ---
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=10

# --- Circuit breaker (services/circuit_breaker.py) ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=10

# --- Upstream service routing (gateway/config.py) ---
USER_SERVICE_URLS=http://localhost:8001,http://localhost:8003
ORDER_SERVICE_URLS=http://localhost:8002

# --- Local service ports (for running services individually / docker-compose) ---
# Unlike everything above, these are NOT read by gateway/config.py — they
# document the --port flags used when invoking uvicorn (see README /
# docker-compose.yml). Changing them here has no effect on their own.
GATEWAY_PORT=8000
USER_SERVICE_PORT=8001
ORDER_SERVICE_PORT=8002
USER_SERVICE_2_PORT=8003
